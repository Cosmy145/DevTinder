{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  }
}

/** 
* * These options mirror how Node.js runs TypeScript and make the compiler reject non-erasable syntax (such as enums, namespaces, and parameter properties) that Node cannot strip

**/
